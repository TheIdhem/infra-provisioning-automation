api_version: networking.k8s.io/v1
kind: Ingress
metadata:
  name: msgc
  namespace: "{{ msgc_namespace }}"
  annotations: 
      kubernetes.io/ingress.class: nginx
      nginx.ingress.kubernetes.io/auth-tls-verify-client: "optional"
      nginx.ingress.kubernetes.io/auth-tls-secret: "{{ msgc_namespace }}/unagi-ca-crt"
      cert-manager.io/cluster-issuer: "letsencrypt-prod"
      external-dns.alpha.kubernetes.io/hostname: api.msgc.{{ public_domain }}
      nginx.ingress.kubernetes.io/global-rate-limit: "1000"
      nginx.ingress.kubernetes.io/global-rate-limit-window: "1m"
      nginx.ingress.kubernetes.io/auth-tls-pass-certificate-to-upstream: "true"
spec:
  tls:
  - hosts:
    - "api.msgc.{{ public_domain }}"
    secretName: msgc-tls
  rules:
    - host: "api.msgc.{{ public_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: "msgc-http"
                port:
                  number: 80
---
api_version: networking.k8s.io/v1
kind: Ingress
metadata:
  name: msgc-register
  namespace: "{{ msgc_namespace }}"
  annotations: 
      kubernetes.io/ingress.class: nginx
      nginx.ingress.kubernetes.io/auth-tls-verify-client: "optional"
      nginx.ingress.kubernetes.io/auth-tls-secret: "{{ msgc_namespace }}/unagi-ca-crt"
      cert-manager.io/cluster-issuer: "letsencrypt-prod"
      external-dns.alpha.kubernetes.io/hostname: api.msgc.{{ public_domain }}
      nginx.ingress.kubernetes.io/global-rate-limit: "10"
      nginx.ingress.kubernetes.io/global-rate-limit-window: "10m"
      nginx.ingress.kubernetes.io/auth-tls-pass-certificate-to-upstream: "true"
      nginx.ingress.kubernetes.io/enable-cors: "true"
      nginx.ingress.kubernetes.io/cors-allow-methods: PUT, GET, POST, OPTIONS, DELETE, PATCH
      nginx.ingress.kubernetes.io/cors-allow-origin: "*"
spec:
  tls:
  - hosts:
    - "api.msgc.{{ public_domain }}"
    secretName: msgc-tls
  rules:
    - host: "api.msgc.{{ public_domain }}"
      http:
        paths:
          - path: /api/register
            pathType: Prefix
            backend:
              service:
                name: "msgc-http"
                port:
                  number: 80
