apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: default-deny
  namespace: {{ agora_namespace }}
spec:
  podSelector: {}
  policyTypes:
    - Ingress
    - Egress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-ingress
  namespace: {{ agora_namespace }}
spec:
  podSelector:
    matchLabels:
      app: agora-token-service
  ingress:
    - from:
        - namespaceSelector:
            matchNames:
            - ingress-nginx
