---
apiVersion: v1
kind: Secret
metadata:
  name: agora-token-service-app-certificate
  namespace: {{ agora_namespace }}
type: Opaque
stringData:
  token: {{ agora_app_certificate }}
---
apiVersion: v1
kind: Secret
metadata:
  name: unagi-ca-crt
  namespace: {{ agora_namespace }}
type: Opaque
data:
  ca.crt: "{{ unagi_ca_pubkey | b64encode }}"
