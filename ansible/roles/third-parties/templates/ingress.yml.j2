---
api_version: networking.k8s.io/v1
kind: Ingress
metadata:
  name: third-parties-ingress
  namespace: "{{ third_parties_namespace }}"
  annotations: 
      kubernetes.io/ingress.class: nginx
      nginx.ingress.kubernetes.io/auth-tls-verify-client: "optional"
      nginx.ingress.kubernetes.io/auth-tls-secret: "{{ third_parties_namespace }}/unagi-ca-crt"
      cert-manager.io/cluster-issuer: "letsencrypt-prod"
      external-dns.alpha.kubernetes.io/hostname: api.infuratest.{{ public_domain }}
      external-dns.alpha.kubernetes.io/hostname: api.etherscantest.{{ public_domain }}
      external-dns.alpha.kubernetes.io/hostname: api.infura.{{ public_domain }}
      external-dns.alpha.kubernetes.io/hostname: api.etherscan.{{ public_domain }}
      nginx.ingress.kubernetes.io/global-rate-limit: "30"
      nginx.ingress.kubernetes.io/global-rate-limit-window: "1m"
      nginx.ingress.kubernetes.io/auth-tls-pass-certificate-to-upstream: "true"
      nginx.ingress.kubernetes.io/proxy-buffering: "on"
      nginx.ingress.kubernetes.io/configuration-snippet: |
        proxy_cache main-cache;
        proxy_cache_valid 200 206 302 304 1m;
        add_header X-Cache-Status-Unagi $upstream_cache_status;
spec:
  tls:
  - hosts:
    - "api.infuratest.{{ public_domain }}"
    - "api.etherscantest.{{ public_domain }}"
    - "api.infura.{{ public_domain }}"
    - "api.etherscan.{{ public_domain }}"
    secretName: third-parties-tls
  rules:
    - host: "api.infuratest.{{ public_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: "nginx-proxy"
                port:
                  number: 80
    - host: "api.etherscantest.{{ public_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: "nginx-proxy"
                port:
                  number: 80
    - host: "api.infura.{{ public_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: "nginx-proxy"
                port:
                  number: 80
    - host: "api.etherscan.{{ public_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: "nginx-proxy"
                port:
                  number: 80
