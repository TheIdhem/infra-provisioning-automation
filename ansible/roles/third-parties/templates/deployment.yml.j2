---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx-proxy
  namespace: {{ third_parties_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: nginx-proxy
  template:
    metadata:
      labels:
        app: nginx-proxy
    spec:
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 100
            podAffinityTerm:
              topologyKey: kubernetes.io/hostname
              labelSelector:
                matchLabels:
                  app: nginx-proxy
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 100
            podAffinityTerm:
              topologyKey: failure-domain.beta.kubernetes.io/zone
              labelSelector:
                matchLabels:
                  app: nginx-proxy
      volumes:
      - name: nginx-config
        configMap:
          name: middleman-nginx-proxy-config
      - name: unagi-ca
        secret:
          defaultMode: 420
          secretName: unagi-ca-crt    
      containers:
      - name: nginx-proxy
        image: {{ ecr_url }}/custom-openresty:919138171-main-4225f64d
        volumeMounts:
        - name: nginx-config
          mountPath: /etc/nginx/conf.d
        - name: unagi-ca
          mountPath: /etc/nginx/conf.d/crt
          readOnly: true
        imagePullPolicy: Always
        ports:
        - name: http-port
          containerPort: 80
        resources:
          limits:
            cpu: "200m"
            memory: "200Mi"
          requests:
            cpu: "100m"
            memory: "100Mi"
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: nginx-proxy
  namespace: {{ third_parties_namespace }}
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app: nginx-proxy
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: nginx-proxy
  namespace: {{ third_parties_namespace }}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: nginx-proxy
  minReplicas: 2
  maxReplicas: 3
  metrics:
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: 70
  - type: Resource
    resource:
      name: memory
      target:
        type: Utilization
        averageUtilization: 80
