---
apiVersion: v1
kind: Service
metadata:
  labels:
    app.kubernetes.io/part-of: datacore
  name: datacore
  namespace: {{ datacore_namespace }}
spec:
  selector:
    app: datacore
  type: ClusterIP
  ports:
  - name: http
    port: 80
    targetPort: http-port
  - name: http-port-app
    port: 3000
    targetPort: http-port-app
