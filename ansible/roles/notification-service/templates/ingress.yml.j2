api_version: networking.k8s.io/v1
kind: Ingress
metadata:
  name: notification-service
  namespace: "{{ notification_namespace }}"
  annotations: 
      kubernetes.io/ingress.class: nginx
      nginx.ingress.kubernetes.io/auth-tls-verify-client: "optional"
      nginx.ingress.kubernetes.io/auth-tls-secret: "{{ notification_namespace }}/unagi-ca-crt"
      cert-manager.io/cluster-issuer: "letsencrypt-prod"
      external-dns.alpha.kubernetes.io/hostname: api.notification.{{ public_domain }}
      nginx.ingress.kubernetes.io/global-rate-limit: "1000"
      nginx.ingress.kubernetes.io/global-rate-limit-window: "1m"
      nginx.ingress.kubernetes.io/auth-tls-pass-certificate-to-upstream: "true"
spec:
  tls:
  - hosts:
    - "api.notification.{{ public_domain }}"
    secretName: notification-tls
  rules:
    - host: "api.notification.{{ public_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: "notification-service"
                port:
                  number: 80
